{
  "manifest_version": 3,
  "name": "Scorpion IDM Integration Module",
  "version": "1.8.2",
  "description": "Download Manager Integration & Video Helper for Scorpion IDM.",
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "permissions": [
    "downloads",
    "activeTab",
    "storage",
    "contextMenus",
    "cookies",
    "webRequest"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png",
    "default_title": "Scorpion IDM"
  },
  "content_scripts": [
    {
      "matches": ["https://web.telegram.org/*"],
      "js": ["browser-transfer.js", "telegram-reader.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "media.js",
        "browser-transfer.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
