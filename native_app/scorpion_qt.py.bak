BROWSER_UA = (
    "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 "
    "(KHTML, like Gecko) Chrome/130.0.0.0 Safari/537.36"
)

CATEGORY_MAP = {
    "Compressed": [".zip", ".rar", ".7z", ".tar", ".gz", ".bz2", ".xz", ".tgz"],
    "Programs": [".exe", ".msi", ".dmg", ".pkg", ".deb", ".rpm", ".apk", ".iso", ".bat"],
    "Video": [".mp4", ".mkv", ".avi", ".mov", ".webm", ".flv", ".wmv", ".m4v", ".ts"],
    "Music": [".mp3", ".wav", ".flac", ".aac", ".ogg", ".m4a", ".wma", ".opus"],
    "Documents": [".pdf", ".doc", ".docx", ".xls", ".xlsx", ".ppt", ".pptx", ".txt", ".epub", ".csv"],
}


def format_bytes(b: int) -> str:
    if not b or b <= 0:
        return "0 B"
    units = ["B", "KB", "MB", "GB", "TB"]
    i = 0
    val = float(b)
    while val >= 1024 and i < len(units) - 1:
        val /= 1024.0
        i += 1
    return f"{val:.2f} {units[i]}"


def format_speed(bps: int) -> str:
    if not bps or bps <= 0:
        return "0 KB/s"
    return f"{format_bytes(bps)}/s"


def format_eta(sec) -> str:
    if sec is None or sec < 0:
        return "—"
    if sec == 0:
        return "Done"
    m, s = divmod(int(sec), 60)
    h, m = divmod(m, 60)
    if h > 0:
        return f"{h}h {m}m {s}s"
    if m > 0:
        return f"{m}m {s}s"
    return f"{s}s"


def detect_category(filename: str, mime: str = "") -> str:
    ext = os.path.splitext(filename or "")[1].lower()
    for cat, exts in CATEGORY_MAP.items():
        if ext in exts:
            return cat
    mime = (mime or "").lower()
    if mime.startswith("video/"):
        return "Video"
    if mime.startswith("audio/"):
        return "Music"
    if "pdf" in mime:
        return "Documents"
    if "zip" in mime or "compressed" in mime:
        return "Compressed"
    return "General"


def sanitize_filename(name: str) -> str:
    clean = "".join("_" if c in '<>:"/\\|?*\r\n\t' else c for c in (name or "download_file")).strip()
    return clean or "scorpion_download.bin"


def extract_filename(url: str, headers: dict) -> str:
    cd = headers.get("Content-Disposition") or headers.get("content-disposition") or ""
    if "filename=" in cd:
        part = cd.split("filename=")[-1].strip().strip('"\';')
        if part:
            return sanitize_filename(urllib.parse.unquote(part))
    try:
        parsed = urllib.parse.urlparse(url)
        base = os.path.basename(urllib.parse.unquote(parsed.path))
        if base and len(base) > 1 and base != "/":
            return sanitize_filename(base)
    except Exception:
        pass
    return "scorpion_file.bin"


# ==============================================================================
# ANIMATED VISUAL WIDGETS (PAINTED NATIVELY IN QT)
# ==============================================================================
def _is_dark_theme() -> bool:
    app = QApplication.instance()
    return bool(app and app.property("scorpionTheme") == "dark")


MODE_COLORS = {
    "active": ("#2563eb", "#06b6d4", "#10b981"),
    "connecting": ("#f59e0b", "#fbbf24", "#f59e0b"),
    "paused": ("#d97706", "#f59e0b", "#fbbf24"),
    "done": ("#059669", "#10b981", "#34d399"),
    "error": ("#be123c", "#e11d48", "#f43f5e"),
}


class SpinnerWidget(QWidget):
    """Rotating ring with a scorpion in the middle; changes glyph by state."""

    def __init__(self, parent=None):
        super().__init__(parent)
        self.setFixedSize(68, 68)
        self.angle = 0
        self.mode = "connecting"

    def set_mode(self, mode: str):
        if mode != self.mode:
            self.mode = mode
            self.update()

    def tick(self):
        if self.mode in ("active", "connecting"):
            self.angle = (self.angle + (9 if self.mode == "active" else 5)) % 360
            self.update()

    def paintEvent(self, event):
        p = QPainter(self)
        p.setRenderHint(QPainter.RenderHint.Antialiasing)
        dark = _is_dark_theme()
        r = QRectF(7, 7, 54, 54)
        p.setPen(QPen(QColor("#334155" if dark else "#e2e8f0"), 5))
        p.drawEllipse(r)

        col = QColor(MODE_COLORS.get(self.mode, MODE_COLORS["active"])[1])
        pen = QPen(col, 5)
        pen.setCapStyle(Qt.PenCapStyle.RoundCap)
        p.setPen(pen)
        if self.mode in ("active", "connecting"):
            p.drawArc(r, int(-self.angle * 16), int(110 * 16))
            p.drawArc(r, int((-self.angle + 180) * 16), int(45 * 16))
        else:
            p.drawEllipse(r)

        glyph = {"done": "✓", "error": "✕", "paused": "❚❚"}.get(self.mode, "🦂")
        if glyph == "🦂":
            p.setFont(QFont("Segoe UI Emoji", 19))
            p.setPen(QColor("#f8fafc" if dark else "#0f172a"))
        else:
            p.setFont(QFont("Segoe UI", 17, QFont.Weight.Bold))
            p.setPen(col)
        p.drawText(self.rect(), Qt.AlignmentFlag.AlignCenter, glyph)


class AnimatedProgressBar(QWidget):
    """Smoothly animated progress bar with moving stripes, shimmer while connecting."""

    def __init__(self, parent=None):
        super().__init__(parent)
        self.setMinimumHeight(30)
        self.target = 0.0
        self.shown = 0.0
        self.phase = 0.0
        self.mode = "connecting"
        self.text = ""

    def set_state(self, pct: float, mode: str, text: str = ""):
        self.target = max(0.0, min(100.0, float(pct or 0)))
        self.mode = mode
        self.text = text

    def tick(self):
        self.shown += (self.target - self.shown) * 0.16
        if abs(self.target - self.shown) < 0.05:
            self.shown = self.target
        self.phase = (self.phase + 1.2) % 24
        self.update()

    def paintEvent(self, event):
        p = QPainter(self)
        p.setRenderHint(QPainter.RenderHint.Antialiasing)
        w, h = self.width(), self.height()
        rect = QRectF(0.5, 0.5, w - 1, h - 1)
        radius = h / 2.0
        dark = _is_dark_theme()

        path = QPainterPath()
        path.addRoundedRect(rect, radius, radius)
        p.fillPath(path, QColor("#0f172a" if dark else "#e2e8f0"))
        p.setClipPath(path)

        c1, c2, c3 = MODE_COLORS.get(self.mode, MODE_COLORS["active"])
        fw = w * self.shown / 100.0

        if self.mode == "connecting" and self.shown < 0.5:
            bw = w * 0.32
            t = (time.time() * 0.7) % 1.0
            x = -bw + (w + bw) * t
            g = QLinearGradient(x, 0, x + bw, 0)
            g.setColorAt(0.0, QColor(245, 158, 11, 0))
            g.setColorAt(0.5, QColor(245, 158, 11, 230))
            g.setColorAt(1.0, QColor(245, 158, 11, 0))
            p.fillRect(QRectF(x, 0, bw, h), g)
        elif fw > 0:
            g = QLinearGradient(0, 0, max(fw, 1), 0)
            g.setColorAt(0.0, QColor(c1))
            g.setColorAt(0.55, QColor(c2))
            g.setColorAt(1.0, QColor(c3))
            p.fillRect(QRectF(0, 0, fw, h), g)

            if self.mode in ("active", "connecting"):
                p.save()
                p.setClipRect(QRectF(0, 0, fw, h), Qt.ClipOperation.IntersectClip)
                p.setPen(Qt.PenStyle.NoPen)
                p.setBrush(QColor(255, 255, 255, 45))
                x = -2 * h + self.phase
                while x < fw + h:
                    poly = QPolygonF([QPointF(x, h), QPointF(x + 12, h), QPointF(x + 12 + h, 0), QPointF(x + h, 0)])
                    p.drawPolygon(poly)
                    x += 24
                p.restore()

            gloss = QLinearGradient(0, 0, 0, h)
            gloss.setColorAt(0.0, QColor(255, 255, 255, 80))
            gloss.setColorAt(0.6, QColor(255, 255, 255, 0))
            p.fillRect(QRectF(0, 0, fw, h * 0.55), gloss)

        p.setClipping(False)
        txt = self.text or f"{self.shown:.1f}%"
        p.setFont(QFont("Segoe UI", 10, QFont.Weight.Bold))
        p.setPen(QColor("#ffffff") if (dark or self.shown > 48) else QColor("#0f172a"))
        p.drawText(rect, Qt.AlignmentFlag.AlignCenter, txt)


class SegmentMapWidget(QWidget):
    """
    IDM-style file map. The whole file is drawn as 'downloaded', then each
    segment's remaining byte range [currentByte..endByte] is painted as empty,
    so it stays correct even after dynamic work-stealing splits.
    """

    def __init__(self, parent=None):
        super().__init__(parent)
        self.setMinimumHeight(34)
        self.segments = []
        self.total = 0
        self.progress = 0.0
        self.done = False
        self.blink = 0

    def set_data(self, segments, total: int, progress: float, done: bool):
        self.segments = segments or []
        self.total = int(total or 0)
        self.progress = float(progress or 0)
        self.done = done
        self.blink = (self.blink + 1) % 6
        self.update()

    def paintEvent(self, event):
        p = QPainter(self)
        p.setRenderHint(QPainter.RenderHint.Antialiasing)
        w, h = self.width(), self.height()
        dark = _is_dark_theme()
        rect = QRectF(0.5, 0.5, w - 1, h - 1)
        path = QPainterPath()
        path.addRoundedRect(rect, 6, 6)
        empty = QColor("#1e293b" if dark else "#e2e8f0")
        p.fillPath(path, empty)
        p.setClipPath(path)

        got = QColor("#10b981" if self.done else "#3b82f6")
        known = self.total > 0 and all(s.get("endByte", -1) >= s.get("startByte", 0) for s in self.segments)

        if not known:
            p.fillRect(QRectF(0, 0, w * min(100.0, self.progress) / 100.0, h), got)
        else:
            p.fillRect(QRectF(0, 0, w, h), got)
            scale = w / float(self.total)
            for s in self.segments:
                cur, end = s.get("currentByte", 0), s.get("endByte", -1)
                if s.get("status") != "completed" and end >= cur:
                    x0, x1 = cur * scale, (end + 1) * scale
                    p.fillRect(QRectF(x0, 0, max(0.0, x1 - x0), h), empty)
                    if s.get("status") == "downloading":
                        head = QColor("#f59e0b" if self.blink < 3 else "#fbbf24")
                        p.fillRect(QRectF(max(0.0, x0 - 2), 0, 3, h), head)
            p.setPen(QPen(QColor(15, 23, 42, 110), 1))
            for s in self.segments:
                x = s.get("startByte", 0) * scale
                if x > 1:
                    p.drawLine(QPointF(x, 0), QPointF(x, h))


class SpeedGraphWidget(QWidget):
    def __init__(self, parent=None):
        super().__init__(parent)
        self.setMinimumHeight(70)
        self.history = []

    def set_history(self, history):
        self.history = list(history or [])
        self.update()

    def paintEvent(self, event):
        p = QPainter(self)
        p.setRenderHint(QPainter.RenderHint.Antialiasing)
        w, h = self.width(), self.height()
        dark = _is_dark_theme()
        bgp = QPainterPath()
        bgp.addRoundedRect(QRectF(0.5, 0.5, w - 1, h - 1), 6, 6)
        p.fillPath(bgp, QColor("#0f172a" if dark else "#f8fafc"))
        p.setPen(QPen(QColor("#1e293b" if dark else "#e2e8f0"), 1))
        for i in range(1, 4):
            y = h * i / 4.0
            p.drawLine(QPointF(4, y), QPointF(w - 4, y))

        if len(self.history) < 2:
            return
        max_spd = max(max(self.history), 102400)
        pts = []
        for i, val in enumerate(self.history):
            x = 4 + (i / (len(self.history) - 1)) * (w - 8)
            y = h - 6 - min(h - 14, (val / max_spd) * (h - 14))
            pts.append(QPointF(x, y))

        area = QPainterPath()
        area.moveTo(pts[0].x(), h)
        for pt in pts:
            area.lineTo(pt)
        area.lineTo(pts[-1].x(), h)
        area.closeSubpath()
        g = QLinearGradient(0, 0, 0, h)
        g.setColorAt(0.0, QColor(56, 189, 248, 120))
        g.setColorAt(1.0, QColor(56, 189, 248, 0))
        p.fillPath(area, g)

        p.setPen(QPen(QColor("#0ea5e9"), 2.2))
        p.drawPolyline(QPolygonF(pts))
        p.setFont(QFont("Consolas", 8))
        p.setPen(QColor("#94a3b8"))
        p.drawText(QRectF(6, 2, w - 12, 14), Qt.AlignmentFlag.AlignLeft, f"max {format_speed(max_spd)}")


# ==============================================================================
# IDM-STYLE PROGRESS WINDOW (INDEPENDENT TOP-LEVEL WINDOW PER DOWNLOAD)
# ==============================================================================
class IDMProgressDialog(QDialog):
    def __init__(self, engine, dl_id: str, lang: str = "ar", parent=None):
        # No Qt parent: must appear on its own even if the main window is hidden/minimized
        super().__init__(None)
        self.engine = engine
        self.dl_id = dl_id
        self.main_window = parent
        self.is_ar = lang == "ar"
        self._was_completed = False

        self.setWindowFlags(
            Qt.WindowType.Window
            | Qt.WindowType.WindowStaysOnTopHint
            | Qt.WindowType.WindowMinimizeButtonHint
            | Qt.WindowType.WindowCloseButtonHint
        )
        if parent is not None and not parent.windowIcon().isNull():
            self.setWindowIcon(parent.windowIcon())
        self.setWindowTitle("Scorpion IDM")
        self.resize(760, 640)
        self.setLayoutDirection(Qt.LayoutDirection.RightToLeft if self.is_ar else Qt.LayoutDirection.LeftToRight)
        T = (lambda ar, en: ar) if self.is_ar else (lambda ar, en: en)
        self.T = T

        root = QVBoxLayout(self)
        root.setSpacing(10)

        # --- Header: spinner + file name + URL ---
        header = QFrame()
        header.setObjectName("CardFrame")
        hl = QHBoxLayout(header)
        self.spinner = SpinnerWidget()
        hl.addWidget(self.spinner)
        title_box = QVBoxLayout()
        self.lbl_filename = QLabel("")
        self.lbl_filename.setStyleSheet("font-size: 15px; font-weight: bold;")
        self.lbl_filename.setWordWrap(True)
        self.lbl_url = QLabel("")
        self.lbl_url.setStyleSheet("font-family: Consolas; font-size: 11px; color: #2563eb;")
        self.lbl_url.setTextInteractionFlags(Qt.TextInteractionFlag.TextSelectableByMouse)
        self.lbl_status = QLabel("")
        self.lbl_status.setStyleSheet("font-weight: bold; font-size: 13px;")
        title_box.addWidget(self.lbl_filename)
        title_box.addWidget(self.lbl_url)
        title_box.addWidget(self.lbl_status)
        hl.addLayout(title_box, 1)
        root.addWidget(header)

        # --- Big animated progress bar ---
        self.pbar = AnimatedProgressBar()
        self.pbar.setMinimumHeight(34)
        root.addWidget(self.pbar)

        # --- Stats cards ---
        stats = QFrame()
        stats.setObjectName("CardFrame")
        grid = QGridLayout(stats)
        grid.setHorizontalSpacing(18)
        grid.setVerticalSpacing(8)
        self.stat = {}
        cards = [
            ("size", T("📦 حجم الملف", "📦 File size")),
            ("done", T("⬇ تم تحميل", "⬇ Downloaded")),
            ("left", T("⏳ المتبقي", "⏳ Remaining")),
            ("speed", T("⚡ سرعة التحميل", "⚡ Transfer rate")),
            ("eta", T("🕒 الوقت المتبقي", "🕒 Time left")),
            ("elapsed", T("⏱ الوقت المنقضي", "⏱ Elapsed")),
            ("resume", T("🔁 إمكانية الاستكمال", "🔁 Resume support")),
            ("conns", T("🧩 الأجزاء / الاتصالات", "🧩 Segments")),
        ]
        for idx, (key, title) in enumerate(cards):
            box = QVBoxLayout()
            t = QLabel(title)
            t.setStyleSheet("color: #64748b; font-size: 11px;")
            v = QLabel("—")
            v.setStyleSheet("font-size: 14px; font-weight: bold; font-family: 'Segoe UI';")
            box.addWidget(t)
            box.addWidget(v)
            grid.addLayout(box, idx // 4, idx % 4)
            self.stat[key] = v
        self.stat["speed"].setStyleSheet("font-size: 14px; font-weight: bold; color: #059669;")
        root.addWidget(stats)

        # --- Tabs ---
        self.tabs = QTabWidget()
        seg_tab = QWidget()
        sl = QVBoxLayout(seg_tab)
        sl.addWidget(QLabel(T("🗺 خريطة أجزاء الملف (الأزرق = تم تحميله، الفارغ = متبقي):",
                              "🗺 File map (blue = downloaded, empty = remaining):")))
        self.seg_map = SegmentMapWidget()
        sl.addWidget(self.seg_map)
        sl.addWidget(QLabel(T("📈 منحنى السرعة اللحظية:", "📈 Live speed:")))
        self.speed_graph = SpeedGraphWidget()
        sl.addWidget(self.speed_graph)
        self.seg_table = QTableWidget(0, 5)
        self.seg_table.setHorizontalHeaderLabels(
            [T("#", "#"), T("تم تحميل", "Downloaded"), T("حجم الجزء", "Part size"),
             T("النسبة", "Progress"), T("الحالة", "Status")]
        )
        hh = self.seg_table.horizontalHeader()
        hh.setSectionResizeMode(QHeaderView.ResizeMode.ResizeToContents)
        hh.setSectionResizeMode(4, QHeaderView.ResizeMode.Stretch)
        self.seg_table.verticalHeader().setVisible(False)
        self.seg_table.setEditTriggers(QTableWidget.EditTrigger.NoEditTriggers)
        self.seg_table.setSelectionMode(QTableWidget.SelectionMode.NoSelection)
        sl.addWidget(self.seg_table, 1)
        self.tabs.addTab(seg_tab, T("🧩 أجزاء التحميل", "🧩 Segments"))

        lim_tab = QWidget()
        ll = QVBoxLayout(lim_tab)
        lim_row = QHBoxLayout()
        lim_row.addWidget(QLabel(T("أقصى سرعة (KB/s — 0 = بدون حد):", "Max speed (KB/s — 0 = unlimited):")))
        self.spin_limit = QSpinBox()
        self.spin_limit.setRange(0, 1000000)
        lim_row.addWidget(self.spin_limit)
        b = QPushButton(T("تطبيق", "Apply"))
        b.setObjectName("PrimaryBtn")
        b.clicked.connect(self.apply_speed_limit)
        lim_row.addWidget(b)
        ll.addLayout(lim_row)
        ll.addStretch()
        self.tabs.addTab(lim_tab, T("⚡ محدد السرعة", "⚡ Speed limiter"))

        chk_tab = QWidget()
        cl = QVBoxLayout(chk_tab)
        self.lbl_hash = QLabel("SHA-256: —")
        self.lbl_hash.setTextInteractionFlags(Qt.TextInteractionFlag.TextSelectableByMouse)
        self.lbl_hash.setWordWrap(True)
        cl.addWidget(self.lbl_hash)
        bh = QPushButton(T("🛡 حساب البصمة SHA-256 و MD5", "🛡 Compute SHA-256 & MD5"))
        bh.setObjectName("PrimaryBtn")
        bh.clicked.connect(self.compute_hash)
        cl.addWidget(bh)
        cl.addStretch()
        self.tabs.addTab(chk_tab, T("🛡 فحص سلامة الملف", "🛡 Checksum"))
        root.addWidget(self.tabs, 1)

        # --- Buttons ---
        btns = QHBoxLayout()
        self.btn_toggle = QPushButton()
        self.btn_toggle.setObjectName("WarnBtn")
        self.btn_toggle.clicked.connect(self.toggle_pause)
        btns.addWidget(self.btn_toggle)
        self.btn_cancel = QPushButton(T("✖ إلغاء التحميل", "✖ Cancel"))
        self.btn_cancel.setObjectName("DangerBtn")
        self.btn_cancel.clicked.connect(self.cancel_download)
        btns.addWidget(self.btn_cancel)
        self.btn_open_file = QPushButton(T("▶ تشغيل الملف", "▶ Open file"))
        self.btn_open_file.setObjectName("SuccessBtn")
        self.btn_open_file.clicked.connect(self.open_file)
        btns.addWidget(self.btn_open_file)
        self.btn_open_folder = QPushButton(T("📁 فتح المجلد", "📁 Open folder"))
        self.btn_open_folder.clicked.connect(self.open_folder)
        btns.addWidget(self.btn_open_folder)
        btns.addStretch()
        self.btn_hide = QPushButton(T("إخفاء", "Hide"))
        self.btn_hide.clicked.connect(self.close)
        btns.addWidget(self.btn_hide)
        root.addLayout(btns)

        self.anim_timer = QTimer(self)
        self.anim_timer.timeout.connect(self._animate)
        self.data_timer = QTimer(self)
        self.data_timer.timeout.connect(self.refresh_ui)
        self.refresh_ui()

    # ----- timers only run while the window is visible -----
    def showEvent(self, event):
        super().showEvent(event)
        self.anim_timer.start(33)
        self.data_timer.start(250)

    def hideEvent(self, event):
        super().hideEvent(event)
        self.anim_timer.stop()
        self.data_timer.stop()

    def _animate(self):
        self.spinner.tick()
        self.pbar.tick()

    def bring_to_front(self):
        self.show()
        self.setWindowState((self.windowState() & ~Qt.WindowState.WindowMinimized) | Qt.WindowState.WindowActive)
        self.raise_()
        self.activateWindow()

    def refresh_ui(self):
        T = self.T
        item = self.engine.downloads.get(self.dl_id)
        if not item:
            self.close()
            return

        status = item.get("status", "")
        phase = item.get("phase", "")
        total = int(item.get("totalSize") or 0)
        done = int(item.get("downloadedBytes") or 0)
        pct = float(item.get("progress") or 0.0)
        is_video = bool(item.get("isVideo"))

        if status == "completed":
            mode, st = "done", T("✅ اكتمل التحميل بنجاح", "✅ Download complete")
            pct = 100.0
        elif status == "error":
            mode, st = "error", T("❌ فشل التحميل: ", "❌ Failed: ") + str(item.get("errorMsg") or "")[:90]
        elif status == "paused":
            mode, st = "paused", T("⏸ متوقف مؤقتاً — اضغط استئناف للإكمال", "⏸ Paused")
        elif phase == "merging":
            mode, st = "connecting", T("🔧 جاري دمج الصوت مع الصورة (FFmpeg)...", "🔧 Merging audio & video...")
        elif phase == "connecting" or done == 0:
            mode = "connecting"
            st = (T("🔄 جاري استخراج روابط الفيديو والجودات...", "🔄 Extracting video streams...")
                  if is_video else T("🔄 جاري الاتصال بالخادم...", "🔄 Connecting..."))
        else:
            mode, st = "active", T("⬇ جاري التحميل...", "⬇ Downloading...")

        self.spinner.set_mode(mode)
        bar_text = f"{pct:.1f}%" if (total > 0 or status == "completed") else (st if mode == "connecting" else format_bytes(done))
        self.pbar.set_state(pct, mode, bar_text)

        self.setWindowTitle(f"{pct:.0f}% — {item.get('filename', '')}")
        self.lbl_filename.setText(f"{'🎬' if is_video else '📄'} {item.get('filename', '')}")
        url = item.get("url", "")
        self.lbl_url.setText(url if len(url) <= 95 else url[:92] + "...")
        color = {"done": "#059669", "error": "#e11d48", "paused": "#d97706", "connecting": "#d97706"}.get(mode, "#2563eb")
        self.lbl_status.setStyleSheet(f"font-weight: bold; font-size: 13px; color: {color};")
        self.lbl_status.setText(st)

        unknown = T("غير معروف", "Unknown")
        self.stat["size"].setText(format_bytes(total) if total > 0 else unknown)
        self.stat["done"].setText(f"{format_bytes(done)}  ({pct:.1f}%)")
        self.stat["left"].setText(format_bytes(max(0, total - done)) if total > 0 else unknown)
        self.stat["speed"].setText(format_speed(item.get("speed", 0)) if status == "downloading" else "—")
        self.stat["eta"].setText(format_eta(item.get("timeLeft")) if status == "downloading" else ("0s" if mode == "done" else "—"))
        started = item.get("startedAt") or (item.get("createdAt", 0) / 1000.0)
        ended = item.get("finishedAt") or time.time()
        self.stat["elapsed"].setText(format_eta(max(0, int(ended - started))) if started else "—")
        self.stat["resume"].setText(T("✔ نعم", "✔ Yes") if (item.get("supportsRange") or is_video) else T("✖ لا", "✖ No"))

        segs = item.get("segments", [])
        active = sum(1 for s in segs if s.get("status") == "downloading")
        self.stat["conns"].setText(f"{active} {T('نشط', 'active')} / {len(segs)}")

        self.seg_map.set_data(segs, total, pct, status == "completed")
        self.speed_graph.set_history(item.get("speedHistory", []))
        self._fill_segment_table(segs)

        finished = status == "completed"
        self.btn_open_file.setVisible(finished)
        self.btn_toggle.setVisible(not finished)
        self.btn_cancel.setVisible(not finished)
        if status == "downloading":
            self.btn_toggle.setText(T("⏸ إيقاف مؤقت", "⏸ Pause"))
            self.btn_toggle.setObjectName("WarnBtn")
        else:
            self.btn_toggle.setText(T("▶ استئناف", "▶ Resume"))
            self.btn_toggle.setObjectName("SuccessBtn")
        self.btn_toggle.style().unpolish(self.btn_toggle)
        self.btn_toggle.style().polish(self.btn_toggle)

        if item.get("checksumSha256"):
            self.lbl_hash.setText(f"SHA-256: {item['checksumSha256']}\nMD5: {item.get('checksumMd5', '')}")

        if finished and not self._was_completed:
            self._was_completed = True
            self.bring_to_front()

    def _fill_segment_table(self, segs):
        T = self.T
        if self.seg_table.rowCount() != len(segs):
            self.seg_table.setRowCount(len(segs))
        status_txt = {
            "completed": T("✅ مكتمل", "✅ Complete"),
            "downloading": T("⬇ يحمّل", "⬇ Receiving"),
            "error": T("❌ خطأ", "❌ Error"),
            "idle": T("⏸ في الانتظار", "⏸ Waiting"),
        }
        for r, s in enumerate(segs):
            dl = int(s.get("downloaded") or 0)
            if s.get("size"):
                size = int(s["size"])
            elif s.get("endByte", -1) >= s.get("currentByte", 0):
                size = dl + (s["endByte"] - s["currentByte"] + 1)
            else:
                size = dl
            part_pct = 100.0 if s.get("status") == "completed" else ((dl / size * 100.0) if size > 0 else 0.0)
            info = s.get("label") or ""
            st = status_txt.get(s.get("status"), s.get("status", ""))
            extra = s.get("info", "")
            if extra and extra not in ("Ready", "Complete", "Receiving data..."):
                st = f"{st} — {extra}"
            values = [f"#{s.get('id')} {info}".strip(), format_bytes(dl), format_bytes(size) if size else "—",
                      f"{min(100.0, part_pct):.1f}%", st]
            for c, v in enumerate(values):
                cell = self.seg_table.item(r, c)
                if cell is None:
                    cell = QTableWidgetItem()
                    self.seg_table.setItem(r, c, cell)
                if cell.text() != v:
                    cell.setText(v)

    def toggle_pause(self):
        item = self.engine.downloads.get(self.dl_id)
        if not item:
            return
        if item["status"] == "downloading":
            self.engine.pause_download(self.dl_id)
        else:
            if item["status"] == "error":
                item["status"] = "paused"
            self.engine.start_download(self.dl_id)
        self.refresh_ui()

    def cancel_download(self):
        ans = QMessageBox.question(
            self,
            self.T("إلغاء التحميل", "Cancel download"),
            self.T("هل تريد إلغاء هذا التحميل وحذفه من القائمة؟", "Cancel this download and remove it?"),
        )
        if ans == QMessageBox.StandardButton.Yes:
            self.engine.delete_download(self.dl_id)
            self.close()

    def apply_speed_limit(self):
        item = self.engine.downloads.get(self.dl_id)
        if item:
            item["speedLimitKbps"] = self.spin_limit.value()

    def compute_hash(self):
        res = self.engine.compute_checksum(self.dl_id)
        if res:
            self.lbl_hash.setText(f"SHA-256: {res['sha256']}\nMD5: {res['md5']}")

    def open_folder(self):
        item = self.engine.downloads.get(self.dl_id)
        if not item:
            return
        target = item["filePath"] if os.path.exists(item["filePath"]) else item["tempFilePath"]
        if os.path.exists(target):
            subprocess.Popen(["explorer", "/select,", os.path.normpath(target)])
        elif os.path.exists(item["saveDir"]):
            os.startfile(item["saveDir"])

    def open_file(self):
        item = self.engine.downloads.get(self.dl_id)
        if item and os.path.exists(item["filePath"]):
            os.startfile(item["filePath"])


# ==============================================================================
# NATIVE ADD NEW DOWNLOAD DIALOG (IDM FILE INFO POPUP)
# ==============================================================================
class AddDownloadDialog(QDialog):
    def __init__(self, engine, initial_url: str = "", is_video: bool = False, lang: str = "ar", parent=None):
        super().__init__(parent)
        self.engine = engine
        self.is_video = is_video
        self.is_ar = lang == "ar"
        self.result_opts = None

        self.setWindowFlags(self.windowFlags() | Qt.WindowType.WindowStaysOnTopHint)
        self.setWindowTitle(
            ("🎬 سحب فيديو ذكي - Scorpion IDM" if is_video else "📥 إضافة رابط تحميل جديد (معلومات الملف - IDM)")
            if self.is_ar
            else ("🎬 Smart Video Grabber - Scorpion IDM" if is_video else "📥 Add New Download (IDM File Info)")
        )
        self.resize(580, 340)
        self.setLayoutDirection(Qt.LayoutDirection.RightToLeft if self.is_ar else Qt.LayoutDirection.LeftToRight)

        layout = QVBoxLayout(self)

        # URL Input + Probe
        layout.addWidget(QLabel("رابط التحميل أو الفيديو (URL):" if self.is_ar else "Download / Video URL:"))
        url_row = QHBoxLayout()
        self.txt_url = QLineEdit(initial_url)
        self.txt_url.setPlaceholderText("https://...")
        url_row.addWidget(self.txt_url)
        btn_probe = QPushButton("🔍 فحص الرابط" if self.is_ar else "🔍 Probe")
        btn_probe.clicked.connect(self.probe_now)
        url_row.addWidget(btn_probe)
        layout.addLayout(url_row)

        # Sample presets
        presets_row = QHBoxLayout()
        for title_ar, title_en, s_url in [
            ("💿 برنامج 7-Zip (.exe)", "💿 7-Zip (.exe)", "https://www.7-zip.org/a/7z2408-x64.exe"),
            ("🎬 برنامج VLC (.exe)", "🎬 VLC Player (.exe)", "https://get.videolan.org/vlc/3.0.21/win64/vlc-3.0.21-win64.exe"),
        ]:
            b = QPushButton(title_ar if self.is_ar else title_en)
            b.clicked.connect(lambda _checked, u=s_url: self.set_sample(u))
            presets_row.addWidget(b)
        layout.addLayout(presets_row)

        self.lbl_probe_info = QLabel("")
        self.lbl_probe_info.setStyleSheet("color: #059669; font-weight: bold;")
        layout.addWidget(self.lbl_probe_info)

        # Filename & Category
        form_grid = QGridLayout()
        form_grid.addWidget(QLabel("اسم الملف:" if self.is_ar else "File Name:"), 0, 0)
        self.txt_filename = QLineEdit()
        form_grid.addWidget(self.txt_filename, 0, 1)

        form_grid.addWidget(QLabel("التصنيف:" if self.is_ar else "Category:"), 0, 2)
        self.cmb_cat = QComboBox()
        self.cmb_cat.addItems(["Programs", "Compressed", "Video", "Music", "Documents", "General"])
        if is_video:
            self.cmb_cat.setCurrentText("Video")
        form_grid.addWidget(self.cmb_cat, 0, 3)

        form_grid.addWidget(QLabel("مجلد الحفظ:" if self.is_ar else "Save Folder:"), 1, 0)
        self.txt_savedir = QLineEdit(self.engine.settings["downloadsRoot"])
        form_grid.addWidget(self.txt_savedir, 1, 1)
        btn_browse = QPushButton("📁 تصفح" if self.is_ar else "📁 Browse")
        btn_browse.clicked.connect(self.browse_dir)
        form_grid.addWidget(btn_browse, 1, 2)

        if is_video:
            form_grid.addWidget(QLabel("جودة الفيديو:" if self.is_ar else "Video Quality:"), 2, 0)
            self.cmb_quality = QComboBox()
            self.cmb_quality.addItems(["best (1080p/4K MP4)", "720p HD", "480p", "audio (MP3)"])
            form_grid.addWidget(self.cmb_quality, 2, 1)
        else:
            form_grid.addWidget(QLabel("عدد الخطوط:" if self.is_ar else "Connections:"), 2, 0)
            self.cmb_conn = QComboBox()
            self.cmb_conn.addItems(["1", "4", "8", "16", "32"])
            self.cmb_conn.setCurrentText("16")
            form_grid.addWidget(self.cmb_conn, 2, 1)

        layout.addLayout(form_grid)
        layout.addStretch()

        # IDM 3 Action Buttons
        btn_row = QHBoxLayout()
        btn_start = QPushButton("🚀 بدء التحميل الآن (Start Download)" if self.is_ar else "🚀 Start Download Now")
        btn_start.setObjectName("PrimaryBtn")
        btn_start.clicked.connect(lambda: self.accept_download(True))
        btn_row.addWidget(btn_start)

        btn_later = QPushButton("🕒 التحميل لاحقاً (Download Later)" if self.is_ar else "🕒 Download Later")
        btn_later.clicked.connect(lambda: self.accept_download(False))
        btn_row.addWidget(btn_later)

        btn_cancel = QPushButton("إلغاء (Cancel)" if self.is_ar else "Cancel")
        btn_cancel.clicked.connect(self.reject)
        btn_row.addWidget(btn_cancel)
        layout.addLayout(btn_row)

        if initial_url:
            QTimer.singleShot(150, self.probe_now)

    def set_sample(self, u: str):
        self.txt_url.setText(u)
        self.probe_now()

    def browse_dir(self):
        d = QFileDialog.getExistingDirectory(self, "Select Save Folder", self.txt_savedir.text())
        if d:
            self.txt_savedir.setText(d)

    def probe_now(self):
        url = self.txt_url.text().strip()
        if not url.startswith("http"):
            return
        self.lbl_probe_info.setText("⏳ جاري فحص الرابط..." if self.is_ar else "⏳ Probing URL...")
        QApplication.processEvents()
        try:
            res = self.engine.probe_url(url)
            self.txt_filename.setText(res["filename"])
            self.cmb_cat.setCurrentText(res["category"])
            self.txt_savedir.setText(res["saveDir"])
            sz = format_bytes(res["totalSize"]) if res["totalSize"] > 0 else "Stream"
            rng = "Yes (يدعم التقسيم والاستكمال)" if res["supportsRange"] else "Direct Stream"
            self.lbl_probe_info.setText(f"✅ الحجم: {sz} | الاستكمال: {rng}")
        except Exception as e:
            self.lbl_probe_info.setText(f"ℹ جاهز للتحميل ({str(e)[:40]})")

    def accept_download(self, start_immediately: bool):
        url = self.txt_url.text().strip()
        if not url:
            return
        q_val = "best"
        if self.is_video:
            raw_q = self.cmb_quality.currentText()
            q_val = "720p" if "720p" in raw_q else "480p" if "480p" in raw_q else "audio" if "audio" in raw_q else "best"

        self.result_opts = {
            "url": url,
            "filename": self.txt_filename.text().strip(),
            "category": self.cmb_cat.currentText(),
            "saveDir": self.txt_savedir.text().strip(),
            "connections": 16 if self.is_video else int(self.cmb_conn.currentText()),
            "startImmediately": start_immediately,
            "isVideo": self.is_video,
            "videoQuality": q_val,
        }
        self.accept()


# ==============================================================================
# CORE MULTI-THREADED ENGINE + SIGNAL BRIDGE
# ==============================================================================
class EngineSignals(QObject):
    updated = pyqtSignal()
    completed = pyqtSignal(str)
    browser_captured = pyqtSignal(dict)
    focus_requested = pyqtSignal()


class ScorpionNativeEngine:
    REQUIRED_EXT_FILES = (
        "manifest.json",
        "background.js",
        "content.js",
        "content.css",
        "popup.html",
        "popup.js",
        "icon.png",
    )

    def __init__(self):
        self.signals = EngineSignals()
        self.project_root = RESOURCE_ROOT
        self.ext_source_dir = os.path.join(self.project_root, "browser-extension")
        self.app_data = os.path.join(os.path.expanduser("~"), "AppData", "Local", "ScorpionIDM")
        self.legacy_prog_ext_dir = os.path.join(
            os.path.expanduser("~"), "AppData", "Local", "Programs", "ScorpionIDM", "browser-extension"
        )
        self.appdata_ext_dir = os.path.join(self.app_data, "browser-extension")
        self.default_dl_root = os.path.join(os.path.expanduser("~"), "Downloads", "Scorpion")
        self.state_file = os.path.join(self.app_data, "scorpion_native_state.json")
        self.rpc_port = 19615
        self.rpc_alive = False

        self.settings = {
            "defaultConnections": 16,
            "globalSpeedLimitKbps": 0,
            "clipboardMonitor": True,
            "autoStartFromBrowser": True,
            "downloadsRoot": self.default_dl_root,
            "userAgent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) ScorpionIDM/2.0",
        }
        self.downloads = {}
        self.controllers = {}
        self.lock = threading.RLock()

        os.makedirs(self.app_data, exist_ok=True)
        os.makedirs(self.default_dl_root, exist_ok=True)
        for cat in list(CATEGORY_MAP.keys()) + ["General"]:
            os.makedirs(os.path.join(self.default_dl_root, cat), exist_ok=True)

        self._load_state()
        self.sync_and_repair_browser_extensions()
        threading.Thread(target=self._speed_loop, daemon=True).start()
        threading.Thread(target=self._start_browser_rpc_bridge, daemon=True).start()

    def sync_and_repair_browser_extensions(self) -> dict:
        """
        Ensures all 7 browser extension files are present and up to date in:
        1. Primary workspace folder (project_root/browser-extension)
        2. ~/AppData/Local/Programs/ScorpionIDM/browser-extension (so existing Chrome/Edge entries work via Retry without removing/re-adding!)
        3. ~/AppData/Local/ScorpionIDM/browser-extension
        """
        repaired_paths = []
        for target_dir in (self.legacy_prog_ext_dir, self.appdata_ext_dir):
            try:
                if os.path.normcase(os.path.abspath(target_dir)) == os.path.normcase(os.path.abspath(self.ext_source_dir)):
                    continue
                os.makedirs(target_dir, exist_ok=True)
                for fname in self.REQUIRED_EXT_FILES:
                    src = os.path.join(self.ext_source_dir, fname)
                    dst = os.path.join(target_dir, fname)
                    if os.path.exists(src):
                        shutil.copy2(src, dst)
                repaired_paths.append(target_dir)
            except Exception:
                pass

        present_count = sum(
            1 for f in self.REQUIRED_EXT_FILES if os.path.exists(os.path.join(self.ext_source_dir, f))
        )
        return {
            "primaryPath": self.ext_source_dir,
            "legacyPath": self.legacy_prog_ext_dir,
            "filesPresent": present_count,
            "filesTotal": len(self.REQUIRED_EXT_FILES),
            "repairedPaths": repaired_paths,
        }

    def _start_browser_rpc_bridge(self):
        engine_ref = self

        class BridgeHandler(BaseHTTPRequestHandler):
            def log_message(self, format, *args):
                return

            def _send_cors(self, code=200):
                self.send_response(code)
                self.send_header("Content-Type", "application/json; charset=utf-8")
                self.send_header("Access-Control-Allow-Origin", "*")
                self.send_header("Access-Control-Allow-Methods", "GET, POST, OPTIONS")
                self.send_header("Access-Control-Allow-Headers", "Content-Type")
                self.send_header("Access-Control-Allow-Private-Network", "true")
                self.end_headers()

            def do_OPTIONS(self):
                self._send_cors(204)

            def do_GET(self):
                parsed = urllib.parse.urlparse(self.path)
                if parsed.path == "/ping":
                    self._send_cors(200)
                    self.wfile.write(json.dumps({"ok": True, "app": "Scorpion IDM Native"}).encode("utf-8"))
                    return
                if parsed.path == "/focus":
                    engine_ref.signals.focus_requested.emit()
                    self._send_cors(200)
                    self.wfile.write(json.dumps({"ok": True}).encode("utf-8"))
                    return
                if parsed.path == "/capture":
                    qs = urllib.parse.parse_qs(parsed.query)
                    payload = {k: v[0] for k, v in qs.items() if v}
                    if payload.get("url"):
                        engine_ref.signals.browser_captured.emit(payload)
                    self._send_cors(200)
                    self.wfile.write(json.dumps({"ok": True}).encode("utf-8"))
                    return
                self._send_cors(404)
                self.wfile.write(json.dumps({"ok": False}).encode("utf-8"))

            def do_POST(self):
                parsed = urllib.parse.urlparse(self.path)
                if parsed.path == "/capture":
                    length = int(self.headers.get("Content-Length") or 0)
                    raw = self.rfile.read(length).decode("utf-8", errors="replace") if length > 0 else "{}"
                    try:
                        payload = json.loads(raw)
                    except Exception:
                        payload = {}
                    if payload.get("url"):
                        engine_ref.signals.browser_captured.emit(payload)
                    self._send_cors(200)
                    self.wfile.write(json.dumps({"ok": True}).encode("utf-8"))
                    return
                self._send_cors(404)
                self.wfile.write(json.dumps({"ok": False}).encode("utf-8"))

        try:
            srv = ThreadingHTTPServer(("127.0.0.1", self.rpc_port), BridgeHandler)
            self.rpc_alive = True
            srv.serve_forever()
        except Exception:
            self.rpc_alive = False

    def _load_state(self):
        try:
            if os.path.exists(self.state_file):
                with open(self.state_file, "r", encoding="utf-8") as f:
                    data = json.load(f)
                if isinstance(data.get("settings"), dict):
                    self.settings.update(data["settings"])
                for item in data.get("downloads", []):
                    if item.get("status") in ("downloading", "connecting"):
                        item["status"] = "paused"
                        item["speed"] = 0
                    self.downloads[item["id"]] = item
        except Exception:
            pass

    def save_state(self):
        with self.lock:
            try:
                with open(self.state_file, "w", encoding="utf-8") as f:
                    json.dump(
                        {"settings": self.settings, "downloads": list(self.downloads.values())},
                        f,
                        ensure_ascii=False,
                        indent=2,
                    )
            except Exception:
                pass

    def probe_url(self, url: str) -> dict:
        hdrs = {"User-Agent": self.settings["userAgent"], "Range": "bytes=0-0"}
        r = requests.get(url, headers=hdrs, stream=True, timeout=12, allow_redirects=True, verify=False)
        final_url = r.url
        status = r.status_code
        resp_headers = dict(r.headers)
        r.close()

        total_size = 0
        supports_range = False
        if status == 206:
            supports_range = True
            cr = resp_headers.get("Content-Range") or resp_headers.get("content-range") or ""
            if "/" in cr:
                try:
                    total_size = int(cr.split("/")[-1])
                except Exception:
                    pass
        elif 200 <= status < 300:
            if "bytes" in (resp_headers.get("Accept-Ranges") or "").lower():
                supports_range = True
            try:
                total_size = int(resp_headers.get("Content-Length") or 0)
            except Exception:
                total_size = 0

        mime = (resp_headers.get("Content-Type") or "application/octet-stream").split(";")[0].strip()
        filename = extract_filename(final_url, resp_headers)
        category = detect_category(filename, mime)
        save_dir = os.path.join(self.settings["downloadsRoot"], category)
        return {
            "url": final_url,
            "filename": filename,
            "totalSize": total_size,
            "supportsRange": supports_range,
            "category": category,
            "saveDir": save_dir,
        }

    def _create_segments(self, total_size: int, count: int):
        if total_size <= 0 or count <= 1:
            return [{"id": 1, "startByte": 0, "endByte": total_size - 1 if total_size > 0 else -1, "currentByte": 0, "downloaded": 0, "status": "idle", "info": "Ready"}]
        segs = []
        chunk = total_size // count
        for i in range(count):
            s = i * chunk
            e = (total_size - 1) if (i == count - 1) else ((i + 1) * chunk - 1)
            segs.append({"id": i + 1, "startByte": s, "endByte": e, "currentByte": s, "downloaded": 0, "status": "idle", "info": "Ready"})
        return segs

    def add_download(self, opts: dict) -> dict:
        url = opts["url"].strip()
        total_size = int(opts.get("totalSize") or 0)
        supports_range = bool(opts.get("supportsRange", True))
        filename = opts.get("filename") or ""
        category = opts.get("category") or ""
        save_dir = opts.get("saveDir") or ""

        if total_size <= 0 and not opts.get("isVideo"):
            try:
                p = self.probe_url(url)
                url = p["url"]
                total_size = p["totalSize"]
                supports_range = p["supportsRange"]
                if not filename:
                    filename = p["filename"]
                if not category:
                    category = p["category"]
                if not save_dir:
                    save_dir = p["saveDir"]
            except Exception:
                pass

        if not filename:
            filename = "Scorpion_Video.mp4" if opts.get("isVideo") else extract_filename(url, {})
        filename = sanitize_filename(filename)
        if not category:
            category = detect_category(filename)
        if not save_dir:
            save_dir = os.path.join(self.settings["downloadsRoot"], category)
        os.makedirs(save_dir, exist_ok=True)

        base, ext = os.path.splitext(filename)
        final_name = filename
        idx = 1
        while os.path.exists(os.path.join(save_dir, final_name)):
            final_name = f"{base} ({idx}){ext}"
            idx += 1

        file_path = os.path.join(save_dir, final_name)
        temp_path = file_path + ".scorpion_part"
        conn_count = max(1, min(32, int(opts.get("connections") or 16))) if (supports_range and total_size > 256 * 1024) else 1

        dl_id = str(uuid.uuid4())
        item = {
            "id": dl_id,
            "url": url,
            "filename": final_name,
            "category": category,
            "saveDir": save_dir,
            "filePath": file_path,
            "tempFilePath": temp_path,
            "totalSize": total_size,
            "downloadedBytes": 0,
            "progress": 0.0,
            "speed": 0,
            "timeLeft": None,
            "status": "paused",
            "supportsRange": supports_range,
            "segments": self._create_segments(total_size, conn_count),
            "speedHistory": [],
            "speedLimitKbps": 0,
            "createdAt": int(time.time() * 1000),
            "isVideo": bool(opts.get("isVideo", False)),
            "videoQuality": opts.get("videoQuality", "best"),
            "referer": (opts.get("referer") or "").strip(),
            "checksumSha256": None,
            "checksumMd5": None,
        }
        with self.lock:
            self.downloads[dl_id] = item
        self.save_state()
        if opts.get("startImmediately", True):
            self.start_download(dl_id)
        return item

    def start_download(self, dl_id: str):
        item = self.downloads.get(dl_id)
        if not item or item["status"] == "completed" or dl_id in self.controllers:
            return
        item["status"] = "downloading"
        item["errorMsg"] = ""
        item["startedAt"] = time.time()
        item.pop("finishedAt", None)
        self.save_state()

        if item.get("isVideo"):
            ctrl = {"aborted": False, "last_bytes": item["downloadedBytes"], "last_time": time.time(), "file_lock": threading.Lock()}
            self.controllers[dl_id] = ctrl
            threading.Thread(target=self._run_video_worker, args=(item, ctrl), daemon=True).start()
            return

        os.makedirs(item["saveDir"], exist_ok=True)
        mode = "r+b" if os.path.exists(item["tempFilePath"]) else "w+b"
        f_obj = open(item["tempFilePath"], mode)
        ctrl = {"aborted": False, "file": f_obj, "file_lock": threading.Lock(), "last_bytes": item["downloadedBytes"], "last_time": time.time()}
        self.controllers[dl_id] = ctrl

        for seg in item["segments"]:
            if seg["endByte"] == -1 or seg["currentByte"] <= seg["endByte"]:
                threading.Thread(target=self._run_segment_worker, args=(item, seg, ctrl), daemon=True).start()
            else:
                seg["status"] = "completed"
                seg["info"] = "Complete"

    def _run_segment_worker(self, item: dict, seg: dict, ctrl: dict):
        seg["status"] = "downloading"
        seg["info"] = "Receiving data..."
        hdrs = {"User-Agent": self.settings["userAgent"]}
        if item.get("referer"):
            hdrs["Referer"] = item["referer"]
        if item["supportsRange"] and seg["endByte"] >= seg["currentByte"]:
            hdrs["Range"] = f"bytes={seg['currentByte']}-{seg['endByte']}"

        try:
            with requests.get(item["url"], headers=hdrs, stream=True, timeout=20, allow_redirects=True, verify=False) as r:
                if r.status_code not in (200, 206):
                    seg["status"] = "error"
                    seg["info"] = f"HTTP {r.status_code}"
                    return
                if r.status_code == 200 and seg["id"] > 1:
                    seg["status"] = "completed"
                    return

                for chunk in r.iter_content(chunk_size=65536):
                    if ctrl["aborted"] or item["status"] != "downloading":
                        return
                    if not chunk:
                        continue
                    to_write = len(chunk)
                    if seg["endByte"] != -1:
                        rem = seg["endByte"] - seg["currentByte"] + 1
                        if rem <= 0:
                            break
                        to_write = min(to_write, rem)

                    with ctrl["file_lock"]:
                        if ctrl["aborted"]:
                            return
                        ctrl["file"].seek(seg["currentByte"])
                        ctrl["file"].write(chunk[:to_write])
                        seg["currentByte"] += to_write
                        seg["downloaded"] += to_write
                        item["downloadedBytes"] += to_write

                    limit_kbps = item.get("speedLimitKbps") or 0
                    if limit_kbps > 0 and item["speed"] > limit_kbps * 1024:
                        time.sleep(0.06)

                    if seg["endByte"] != -1 and seg["currentByte"] > seg["endByte"]:
                        break

            if not ctrl["aborted"]:
                self._on_segment_done(item, seg, ctrl)
        except Exception as e:
            if not ctrl["aborted"]:
                seg["status"] = "error"
                seg["info"] = str(e)[:35]
        finally:
            self._check_all_failed(item, ctrl)

    def _check_all_failed(self, item: dict, ctrl: dict):
        """If no segment is still running and some failed, mark the whole download as error."""
        if ctrl.get("aborted") or item.get("status") != "downloading":
            return
        segs = item.get("segments") or []
        if any(s.get("status") == "downloading" for s in segs):
            return
        failed = [s for s in segs if s.get("status") == "error"]
        if failed:
            self.controllers.pop(item["id"], None)
            ctrl["aborted"] = True
            try:
                ctrl["file"].close()
            except Exception:
                pass
            item["status"] = "error"
            item["speed"] = 0
            item["errorMsg"] = failed[0].get("info", "Connection error")
            self.save_state()

    def _on_segment_done(self, item: dict, completed_seg: dict, ctrl: dict):
        with ctrl["file_lock"]:
            completed_seg["status"] = "completed"
            completed_seg["info"] = "Complete"

            # IDM Dynamic Work Stealing
            if item["supportsRange"] and item["totalSize"] > 0 and not ctrl["aborted"]:
                largest = None
                max_rem = 0
                for cand in item["segments"]:
                    if cand["status"] == "downloading" and cand["endByte"] > cand["currentByte"]:
                        rem = cand["endByte"] - cand["currentByte"] + 1
                        if rem > max_rem:
                            max_rem = rem
                            largest = cand
                if largest and max_rem >= 1024 * 1024:
                    half = max_rem // 2
                    new_start = largest["currentByte"] + half
                    old_end = largest["endByte"]
                    if new_start < old_end:
                        largest["endByte"] = new_start - 1
                        largest["info"] = f"Split -> Helping #{completed_seg['id']}"
                        completed_seg["startByte"] = new_start
                        completed_seg["currentByte"] = new_start
                        completed_seg["endByte"] = old_end
                        completed_seg["status"] = "downloading"
                        completed_seg["info"] = f"Helping #{largest['id']} (Work Steal)"
                        threading.Thread(target=self._run_segment_worker, args=(item, completed_seg, ctrl), daemon=True).start()
                        return

            if all(s["status"] == "completed" for s in item["segments"]):
                self._finalize(item, ctrl)

    def _scrape_media_urls(self, page_url: str, referer: str = "") -> list:
        """Fetch an embed/player page and pull out .m3u8 / .mp4 links (incl. escaped JSON)."""
        import re

        hdrs = {"User-Agent": BROWSER_UA}
        if referer:
            hdrs["Referer"] = referer
        try:
            html = requests.get(page_url, headers=hdrs, timeout=15, verify=False).text
        except Exception:
            return []
        html = html.replace("\\/", "/").replace("\\u002F", "/").replace("&amp;", "&")
        # Many embed hosts hide the player config in P.A.C.K.E.R-packed JS: unpack it first
        if "eval(function(p,a,c,k,e,d)" in html:
            try:
                from yt_dlp.utils import decode_packed_codes

                for block in re.findall(r"eval\(function\(p,a,c,k,e,d\).*?\.split\('\|'\)[^)]*\)\)", html, re.S):
                    try:
                        html += "\n" + decode_packed_codes(block).replace("\\/", "/")
                    except Exception:
                        pass
            except Exception:
                pass
        found = re.findall(r"""https?://[^\s"'<>\\]+?\.(?:m3u8|mpd|mp4)(?:\?[^\s"'<>\\]*)?""", html, re.I)
        # relative manifest paths like file:"/hls/xyz/master.m3u8"
        for rel in re.findall(r"""["'](/[^"'\s]+?\.m3u8(?:\?[^"'\s]*)?)["']""", html, re.I):
            found.append(urllib.parse.urljoin(page_url, rel))
        uniq = []
        for u in found:
            if u not in uniq and not re.search(r"\.(jpg|png|gif)\b", u, re.I):
                uniq.append(u)
        uniq.sort(key=lambda u: (0 if ".m3u8" in u.lower() else 1, 0 if "master" in u.lower() else 1))
        return uniq[:6]

    def _extract_with_fallback(self, ydl, item: dict):
        """Try yt-dlp on the URL; if the site is unsupported, look for the real stream in the page."""
        try:
            return ydl.extract_info(item["url"], download=False)
        except Exception as first_err:
            if not item["url"].lower().split("?")[0].endswith((".html", ".htm", "/")) and "unsupported url" not in str(first_err).lower():
                raise
            for cand in self._scrape_media_urls(item["url"], item.get("referer") or item["url"]):
                try:
                    info = ydl.extract_info(cand, download=False)
                    item["url"] = cand
                    return info
                except Exception:
                    continue
            raise RuntimeError(
                "الموقع ده بيخفي رابط الفيديو. شغّل الفيديو الأول لثواني ثم اضغط زر التحميل تاني "
                "علشان الإضافة تلتقط الرابط المباشر من المشغل."
            ) from first_err

    def _run_video_worker(self, item: dict, ctrl: dict):
        if not HAS_YTDLP:
            item["status"] = "error"
            return

        item["phase"] = "connecting"
        item["errorMsg"] = ""
        if item.get("segments"):
            item["segments"][0]["status"] = "downloading"
            item["segments"][0]["info"] = "Extracting streams..."

        q = item.get("videoQuality", "best")
        ffmpeg_bin = shutil.which("ffmpeg") or os.path.expandvars(
            r"%LOCALAPPDATA%\Microsoft\WinGet\Links\ffmpeg.EXE"
        )
        has_ffmpeg = bool(ffmpeg_bin and os.path.exists(ffmpeg_bin))

        if has_ffmpeg:
            # Prefer H.264 (avc1): AV1/VP9 files do not play in the default Windows player
            if q == "720p":
                fmt = "bestvideo[height<=720][vcodec^=avc1]+bestaudio[ext=m4a]/bestvideo[height<=720][ext=mp4]+bestaudio[ext=m4a]/best[height<=720]/bestvideo+bestaudio/best"
            elif q == "480p":
                fmt = "bestvideo[height<=480][vcodec^=avc1]+bestaudio[ext=m4a]/bestvideo[height<=480][ext=mp4]+bestaudio[ext=m4a]/best[height<=480]/bestvideo+bestaudio/best"
            elif q == "audio":
                fmt = "bestaudio[ext=m4a]/bestaudio/best"
            else:
                fmt = "bestvideo[vcodec^=avc1]+bestaudio[ext=m4a]/bestvideo[ext=mp4]+bestaudio[ext=m4a]/bestvideo+bestaudio/best"
        else:
            fmt = "best"

        class QuietYtdlpLogger:
            def debug(self, msg):
                pass

            def info(self, msg):
                pass

            def warning(self, msg):
                pass

            def error(self, msg):
                pass

        def relayout_segments():
            offset = 0
            for s in item["segments"]:
                size = int(s.get("size") or 0)
                s["startByte"] = offset
                s["endByte"] = offset + size - 1 if size else -1
                s["currentByte"] = offset + min(size, int(s.get("downloaded") or 0)) if size else offset
                offset += size
            item["totalSize"] = offset

        def hook(d):
            if ctrl["aborted"]:
                raise RuntimeError("Paused")
            segs = item.get("segments") or []
            if not segs:
                return
            fid = str((d.get("info_dict") or {}).get("format_id") or "")
            seg = next((s for s in segs if s.get("formatId") == fid), None) or next(
                (s for s in segs if s.get("status") != "completed"), segs[-1]
            )
            if d["status"] == "downloading":
                item["phase"] = "downloading"
                dl_b = int(d.get("downloaded_bytes") or 0)
                tot_b = int(d.get("total_bytes") or d.get("total_bytes_estimate") or 0)
                if tot_b and abs(tot_b - int(seg.get("size") or 0)) > 1024:
                    seg["size"] = tot_b
                seg["downloaded"] = dl_b
                seg["status"] = "downloading"
                relayout_segments()
                total = item["totalSize"]
                item["downloadedBytes"] = sum(int(s.get("downloaded") or 0) for s in segs)
                if total > 0:
                    item["progress"] = min(99.9, round(item["downloadedBytes"] / total * 100, 2))
                elif d.get("fragment_index") and d.get("fragment_count"):
                    item["progress"] = min(99.9, round(d["fragment_index"] / max(1, d["fragment_count"]) * 100, 2))
                spd = int(d.get("speed") or 0)
                item["speed"] = spd
                remaining = max(0, total - item["downloadedBytes"])
                item["timeLeft"] = int(remaining / spd) if (spd > 0 and total > 0) else d.get("eta")
                item["speedHistory"] = (item.get("speedHistory") or [])[-59:] + [spd]
            elif d["status"] == "finished":
                if seg.get("size"):
                    seg["downloaded"] = seg["size"]
                seg["status"] = "completed"
                relayout_segments()
                item["downloadedBytes"] = sum(int(s.get("downloaded") or 0) for s in segs)
                if all(s.get("status") == "completed" for s in segs) and len(segs) > 1:
                    item["phase"] = "merging"
                    item["speed"] = 0

        base_no_ext = os.path.splitext(item["filePath"])[0]
        outtmpl = base_no_ext + ".%(ext)s"

        ydl_opts = {
            "format": fmt,
            "outtmpl": outtmpl,
            "noplaylist": True,
            "continuedl": True,
            "hls_prefer_native": True,
            "retries": 10,
            "fragment_retries": 10,
            "progress_hooks": [hook],
            "quiet": True,
            "no_warnings": True,
            "nocheckcertificate": True,
            "concurrent_fragment_downloads": 8,
            "logger": QuietYtdlpLogger(),
        }
        if item.get("referer"):
            ref = item["referer"]
            pr = urllib.parse.urlparse(ref)
            ydl_opts["http_headers"] = {
                "Referer": ref,
                "Origin": f"{pr.scheme}://{pr.netloc}",
                "User-Agent": BROWSER_UA,
            }
        if has_ffmpeg:
            ydl_opts["ffmpeg_location"] = ffmpeg_bin
            if q == "audio":
                ydl_opts["postprocessors"] = [
                    {"key": "FFmpegExtractAudio", "preferredcodec": "mp3", "preferredquality": "192"}
                ]
            else:
                ydl_opts["merge_output_format"] = "mp4"
        else:
            ydl_opts["extractor_args"] = {"youtube": {"player_client": ["android", "ios", "web"]}}

        try:
            with yt_dlp.YoutubeDL(ydl_opts) as ydl:
                # 1) Extract streams first so the window can show real parts & sizes
                info = self._extract_with_fallback(ydl, item)
                if ctrl["aborted"]:
                    return
                reqs = info.get("requested_formats") or [info]
                new_segs = []
                for i, f in enumerate(reqs, 1):
                    has_v = f.get("vcodec") not in (None, "none")
                    has_a = f.get("acodec") not in (None, "none")
                    if has_v and has_a:
                        kind = "🎬+🎵"
                    elif has_v:
                        kind = "🎬 " + str(f.get("resolution") or f.get("format_note") or "video")
                    else:
                        kind = "🎵 audio"
                    new_segs.append({
                        "id": i,
                        "formatId": str(f.get("format_id") or ""),
                        "label": f"{kind} ({f.get('ext', '')})",
                        "size": int(f.get("filesize") or f.get("filesize_approx") or 0),
                        "downloaded": 0,
                        "startByte": 0, "endByte": -1, "currentByte": 0,
                        "status": "idle", "info": "",
                    })
                item["segments"] = new_segs
                relayout_segments()
                item["phase"] = "downloading"

                # 2) Download using the already-extracted info (no second extraction)
                info = ydl.process_ie_result(info, download=True)
                actual = ydl.prepare_filename(info)
                for cand_ext in (".mp3", ".mp4", ".m4a", ".mkv", ".webm"):
                    cand_path = base_no_ext + cand_ext
                    if os.path.exists(cand_path):
                        actual = cand_path
                        break
                if os.path.exists(actual):
                    item["filePath"] = actual
                    item["filename"] = os.path.basename(actual)
                    item["totalSize"] = os.path.getsize(actual)
                    item["downloadedBytes"] = item["totalSize"]
            for s in item.get("segments") or []:
                s["status"] = "completed"
                if s.get("size"):
                    s["downloaded"] = s["size"]
                s["currentByte"] = s.get("endByte", 0) + 1
            item["phase"] = "done"
            item["finishedAt"] = time.time()
            item["progress"] = 100.0
            item["speed"] = 0
            item["timeLeft"] = 0
            item["status"] = "completed"
            self.controllers.pop(item["id"], None)
            self.save_state()
            self.signals.completed.emit(item["id"])
        except Exception as err:
            self.controllers.pop(item["id"], None)
            if not ctrl["aborted"]:
                msg = str(err).replace("ERROR:", "").strip()
                item["status"] = "error"
                item["errorMsg"] = msg[:160]
                item["speed"] = 0
                for s in item.get("segments") or []:
                    if s.get("status") != "completed":
                        s["status"] = "error"
                        s["info"] = msg[:60]
                self.save_state()

    def _finalize(self, item: dict, ctrl: dict):
        self.controllers.pop(item["id"], None)
        try:
            ctrl["file"].close()
            if os.path.exists(item["tempFilePath"]):
                if os.path.exists(item["filePath"]):
                    os.remove(item["filePath"])
                os.replace(item["tempFilePath"], item["filePath"])
        except Exception:
            pass
        item["downloadedBytes"] = item["totalSize"] or item["downloadedBytes"]
        item["totalSize"] = item["downloadedBytes"]
        item["progress"] = 100.0
        item["speed"] = 0
        item["timeLeft"] = 0
        item["finishedAt"] = time.time()
        item["status"] = "completed"
        self.save_state()
        self.signals.completed.emit(item["id"])

    def pause_download(self, dl_id: str):
        ctrl = self.controllers.pop(dl_id, None)
        if ctrl:
            ctrl["aborted"] = True
            try:
                if "file" in ctrl and ctrl["file"]:
                    ctrl["file"].close()
            except Exception:
                pass
        item = self.downloads.get(dl_id)
        if item and item["status"] != "completed":
            item["status"] = "paused"
            item["speed"] = 0
            self.save_state()

    def pause_all(self):
        for k in list(self.controllers.keys()):
            self.pause_download(k)

    def delete_download(self, dl_id: str):
        self.pause_download(dl_id)
        item = self.downloads.pop(dl_id, None)
        if item and item.get("tempFilePath") and os.path.exists(item["tempFilePath"]):
            try:
                os.remove(item["tempFilePath"])
            except Exception:
                pass
        self.save_state()

    def delete_completed(self):
        for k in [k for k, v in self.downloads.items() if v["status"] == "completed"]:
            self.downloads.pop(k, None)
        self.save_state()

    def compute_checksum(self, dl_id: str):
        item = self.downloads.get(dl_id)
        if not item or not os.path.exists(item["filePath"]):
            return None
        sha = hashlib.sha256()
        md5 = hashlib.md5()
        with open(item["filePath"], "rb") as f:
            while chunk := f.read(262144):
                sha.update(chunk)
                md5.update(chunk)
        item["checksumSha256"] = sha.hexdigest()
        item["checksumMd5"] = md5.hexdigest()
        return {"sha256": item["checksumSha256"], "md5": item["checksumMd5"]}

    def _speed_loop(self):
        while True:
            time.sleep(0.3)
            now = time.time()
            for dl_id, ctrl in list(self.controllers.items()):
                item = self.downloads.get(dl_id)
                if not item or item["status"] != "downloading" or item.get("isVideo"):
                    continue
                elapsed = max(0.1, now - ctrl["last_time"])
                delta = max(0, item["downloadedBytes"] - ctrl["last_bytes"])
                inst = int(delta / elapsed)
                item["speed"] = int(item["speed"] * 0.6 + inst * 0.4) if item["speed"] > 0 else inst
                ctrl["last_bytes"] = item["downloadedBytes"]
                ctrl["last_time"] = now
                if item["totalSize"] > 0:
                    item["progress"] = min(99.9, round((item["downloadedBytes"] / item["totalSize"]) * 100, 2))
                    rem = max(0, item["totalSize"] - item["downloadedBytes"])
                    item["timeLeft"] = int(rem / item["speed"]) if item["speed"] > 0 else None
                item["speedHistory"] = (item.get("speedHistory") or [])[-35:] + [item["speed"]]


# ==============================================================================
# NATIVE BROWSER SETUP & 1-CLICK INTEGRATION DIALOG (IDM BROWSER INTEGRATION)
# ==============================================================================
class BrowserSetupDialog(QDialog):
    def __init__(self, engine: ScorpionNativeEngine, lang: str = "ar", parent=None):
        super().__init__(parent)
        self.engine = engine
        self.is_ar = lang == "ar"
        self.parent_win = parent

        self.setWindowTitle(
            "🧩 سيطب وربط المتصفحات (Browser Integration Setup) - Scorpion IDM"
            if self.is_ar
            else "🧩 Browser Integration Setup - Scorpion IDM"
        )
        self.resize(720, 520)
        self.setLayoutDirection(Qt.LayoutDirection.RightToLeft if self.is_ar else Qt.LayoutDirection.LeftToRight)

        layout = QVBoxLayout(self)
        layout.setSpacing(12)

        # 1. Status & Auto-Repair Card
        status_card = QFrame()
        status_card.setObjectName("CardFrame")
        st_layout = QVBoxLayout(status_card)

        title = QLabel(
            "🦂 مركز ربط المتصفحات الذكي (وداعاً لحذف وإعادة إضافة الإضافة كل مرة!)"
            if self.is_ar
            else "🦂 Smart Browser Integration Center (One-Time Permanent Setup)"
        )
        title.setStyleSheet("font-size: 15px; font-weight: bold; color: #2563eb;")
        st_layout.addWidget(title)

        self.lbl_bridge_status = QLabel()
        self.lbl_files_status = QLabel()
        st_layout.addWidget(self.lbl_bridge_status)
        st_layout.addWidget(self.lbl_files_status)

        btn_repair = QPushButton(
            "🔧 تثبيت وإصلاح ملفات الإضافة تلقائياً في كل المسارات الآن (بدون حذف أو إعادة إضافة)"
            if self.is_ar
            else "🔧 Auto-Install & Repair Extension Files in All Paths Now"
        )
        btn_repair.setObjectName("SuccessBtn")
        btn_repair.clicked.connect(self.run_auto_repair)
        st_layout.addWidget(btn_repair)

        layout.addWidget(status_card)

        # 2. Browser Cards (Chrome / Edge / Brave)
        browsers_card = QFrame()
        browsers_card.setObjectName("CardFrame")
        br_layout = QVBoxLayout(browsers_card)

        br_header = QLabel(
            "🌐 اختر متصفحك للتشغيل الفوري أو الربط الثابت لمرة واحدة فقط:"
            if self.is_ar
            else "🌐 Choose your browser for 1-Click Launch or Permanent Setup:"
        )
        br_header.setStyleSheet("font-weight: bold; font-size: 13.5px;")
        br_layout.addWidget(br_header)

        for br_name, br_key, ext_url in [
            ("Google Chrome", "chrome", "chrome://extensions"),
            ("Microsoft Edge", "msedge", "edge://extensions"),
            ("Brave Browser", "brave", "brave://extensions"),
        ]:
            row = QHBoxLayout()
            lbl = QLabel(f"🌐 {br_name}")
            lbl.setStyleSheet("font-weight: bold; min-width: 140px;")
            row.addWidget(lbl)

            btn_launch = QPushButton(
                f"🚀 فتح {br_name} مفعلاً بالإضافة فوراً"
                if self.is_ar
                else f"🚀 Launch {br_name} with Extension"
            )
            btn_launch.setObjectName("PrimaryBtn")
            btn_launch.clicked.connect(lambda _c, k=br_key: self.launch_browser_with_ext(k))
            row.addWidget(btn_launch)

            btn_setup = QPushButton(
                "🧩 ربط ثابت (نسخ المسار + فتح الإضافات)"
                if self.is_ar
                else "🧩 Permanent Setup (Copy Path + Open Extensions)"
            )
            btn_setup.clicked.connect(lambda _c, k=br_key, u=ext_url: self.open_extensions_page(k, u))
            row.addWidget(btn_setup)

            br_layout.addLayout(row)

        # Permanent folder path display + Open Folder button
        path_row = QHBoxLayout()
        self.txt_ext_path = QLineEdit(self.engine.ext_source_dir)
        self.txt_ext_path.setReadOnly(True)
        path_row.addWidget(self.txt_ext_path)

        btn_copy_path = QPushButton("📋 نسخ المسار الثابت" if self.is_ar else "📋 Copy Path")
        btn_copy_path.clicked.connect(self.copy_ext_path)
        path_row.addWidget(btn_copy_path)

        btn_open_dir = QPushButton("📁 فتح مجلد الإضافة" if self.is_ar else "📁 Open Folder")
        btn_open_dir.clicked.connect(lambda: os.startfile(self.engine.ext_source_dir))
        path_row.addWidget(btn_open_dir)
        br_layout.addLayout(path_row)

        layout.addWidget(browsers_card)

        # 3. Automatic Download Capture Options
        opts_card = QFrame()
        opts_card.setObjectName("CardFrame")
        opts_layout = QVBoxLayout(opts_card)

        self.chk_auto_start = QCheckBox(
            "⚡ بدء التحميل تلقائياً وبأقصى سرعة فور الضغط على أي رابط أو زر فيديو في المتصفح (بدل السؤال في كل مرة)"
            if self.is_ar
            else "⚡ Automatically start downloads immediately when clicked in browser"
        )
        self.chk_auto_start.setChecked(bool(self.engine.settings.get("autoStartFromBrowser", True)))
        self.chk_auto_start.toggled.connect(self.on_auto_start_toggled)
        opts_layout.addWidget(self.chk_auto_start)

        tip_lbl = QLabel(
            "💡 ملاحظة مهمة: إذا كانت الإضافة موجودة لديك مسبقاً في المتصفح وتظهر رسالة خطأ قديمة، فقط اضغط زر (Retry / إعادة المحاولة 🔄) في المتصفح بعد ضغط زر الإصلاح بالأعلى — لن تحتاج لحذفها أو إضافتها من جديد أبداً!"
            if self.is_ar
            else "💡 Tip: If the extension was already added in your browser, simply click Retry/Reload in the browser — no need to remove and re-add!"
        )
        tip_lbl.setWordWrap(True)
        tip_lbl.setStyleSheet("color: #059669; font-weight: bold;")
        opts_layout.addWidget(tip_lbl)

        layout.addWidget(opts_card)

        # Bottom Close Button
        bottom_row = QHBoxLayout()
        bottom_row.addStretch()
        btn_close = QPushButton("إغلاق (Close)" if self.is_ar else "Close")
        btn_close.clicked.connect(self.accept)
        bottom_row.addWidget(btn_close)
        layout.addLayout(bottom_row)

        self.refresh_status()

    def refresh_status(self):
        info = self.engine.sync_and_repair_browser_extensions()
        if self.engine.rpc_alive:
            self.lbl_bridge_status.setText(
                f"🟢 جسر الاتصال المحلي بالمتصفحات (Port {self.engine.rpc_port}): متصل ويعمل بنجاح 100%"
                if self.is_ar
                else f"🟢 Local Browser RPC Bridge (Port {self.engine.rpc_port}): ONLINE & READY"
            )
            self.lbl_bridge_status.setStyleSheet("color: #059669; font-weight: bold;")
        else:
            self.lbl_bridge_status.setText(
                f"🟠 جسر الاتصال المحلي (Port {self.engine.rpc_port}): قيد التشغيل..."
                if self.is_ar
                else f"🟠 Local Browser Bridge (Port {self.engine.rpc_port}): Starting..."
            )

        self.lbl_files_status.setText(
            f"✅ ملفات الإضافة ({info['filesPresent']}/{info['filesTotal']}): سليمة ومثبتة في المسار الأساسي وفي مسار المتصفح الثابت (AppData)"
            if self.is_ar
            else f"✅ Extension Files ({info['filesPresent']}/{info['filesTotal']}): Intact & synced across all paths"
        )
        self.lbl_files_status.setStyleSheet("color: #2563eb; font-weight: bold;")

    def run_auto_repair(self):
        info = self.engine.sync_and_repair_browser_extensions()
        self.refresh_status()
        QMessageBox.information(
            self,
            "تم إصلاح وتفعيل سيطب المتصفحات ✅" if self.is_ar else "Browser Setup Repaired ✅",
            (
                f"✅ تم تحديث وإصلاح جميع ملفات الإضافة ({info['filesPresent']}/{info['filesTotal']}) بنجاح في:\n\n"
                f"1️⃣ {info['primaryPath']}\n"
                f"2️⃣ {info['legacyPath']}\n\n"
                "إذا كانت الإضافة مضافة لديك من قبل في المتصفح، فقط اضغط (Retry / تحديث 🔄) في المتصفح وستعمل فوراً بدون الحاجة لحذفها وإضافتها!"
            )
            if self.is_ar
            else (
                f"✅ All {info['filesPresent']}/{info['filesTotal']} extension files repaired and synced in:\n"
                f"1. {info['primaryPath']}\n2. {info['legacyPath']}"
            ),
        )

    def _find_browser_exe(self, br_key: str) -> str:
        candidates = {
            "chrome": [
                r"C:\Program Files\Google\Chrome\Application\chrome.exe",
                r"C:\Program Files (x86)\Google\Chrome\Application\chrome.exe",
                os.path.expandvars(r"%LOCALAPPDATA%\Google\Chrome\Application\chrome.exe"),
            ],
            "msedge": [
                r"C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe",
                r"C:\Program Files\Microsoft\Edge\Application\msedge.exe",
            ],
            "brave": [
                r"C:\Program Files\BraveSoftware\Brave-Browser\Application\brave.exe",
                os.path.expandvars(r"%LOCALAPPDATA%\BraveSoftware\Brave-Browser\Application\brave.exe"),
            ],
        }
        for p in candidates.get(br_key, []):
            if os.path.exists(p):
                return p
        return br_key

    def copy_ext_path(self):
        self.engine.sync_and_repair_browser_extensions()
        if self.parent_win:
            self.parent_win.last_clip = self.engine.ext_source_dir
        QApplication.clipboard().setText(self.engine.ext_source_dir)

    def launch_browser_with_ext(self, br_key: str):
        self.engine.sync_and_repair_browser_extensions()
        exe = self._find_browser_exe(br_key)
        try:
            subprocess.Popen([exe, f"--load-extension={self.engine.ext_source_dir}"])
        except Exception as e:
            QMessageBox.warning(self, "Browser", str(e))

    def open_extensions_page(self, br_key: str, ext_url: str):
        self.copy_ext_path()
        exe = self._find_browser_exe(br_key)
        try:
            subprocess.Popen([exe, ext_url])
        except Exception:
            pass
        QMessageBox.information(
            self,
            "تم نسخ المسار وفتح المتصفح ✅" if self.is_ar else "Path Copied & Browser Opened ✅",
            (
                "✅ تم نسخ مسار الإضافة الثابت تلقائياً إلى الحافظة!\n\n"
                "إذا لم تكن الإضافة موجودة في المتصفح:\n"
                "1️⃣ اضغط زر (Load unpacked / تحميل غير محزوم) في صفحة الإضافات التي فتحت الآن.\n"
                "2️⃣ اضغط (Ctrl + V) ثم (Enter) — وسيظل هذا المسار ثابتاً للأبد ولن تحتاج لإعادته مرة أخرى!"
            )
            if self.is_ar
            else "Extension path copied to clipboard! Click 'Load unpacked' and press Ctrl+V then Enter.",
        )

    def on_auto_start_toggled(self, checked: bool):
        self.engine.settings["autoStartFromBrowser"] = checked
        self.engine.save_state()


# ==============================================================================
# MAIN NATIVE DESKTOP APPLICATION WINDOW (SCORPION IDM)
# ==============================================================================
class ScorpionMainWindow(QMainWindow):
    def __init__(self, app: QApplication):
        super().__init__()
        self.app = app
        self.engine = ScorpionNativeEngine()
        self.theme = self.engine.settings.get("theme", "light")
        self.lang = self.engine.settings.get("lang", "ar")
        self.filter_state = "all"
        self.filter_cat = "ALL"
        self.open_progress_dialogs = {}

        icon_path = os.path.join(RESOURCE_ROOT, "build", "icon.ico")
        self.app_icon = QIcon(icon_path) if os.path.exists(icon_path) else QIcon()
        if not self.app_icon.isNull():
            self.setWindowIcon(self.app_icon)

        self.resize(1180, 720)
        self.setup_ui()
        self.setup_tray()
        self.apply_theme_and_lang()

        # Clipboard monitoring for direct links
        self.clipboard = QApplication.clipboard()
        self.last_clip = self.clipboard.text().strip()
        self.clipboard.dataChanged.connect(self.on_clipboard_changed)

        # UI refresh timer (250ms)
        self.timer = QTimer(self)
        self.timer.timeout.connect(self.refresh_all)
        self.timer.start(250)

        self.engine.signals.completed.connect(self.on_download_completed)
        self.engine.signals.browser_captured.connect(self.on_browser_captured)
        self.engine.signals.focus_requested.connect(self.bring_to_front)

    def setup_tray(self):
        if not QSystemTrayIcon.isSystemTrayAvailable():
            self.tray_icon = None
            return
        self.tray_icon = QSystemTrayIcon(self.app_icon, self)
        self.tray_icon.setToolTip("Scorpion Download Manager (IDM)")
        tray_menu = QMenu(self)
        act_show = QAction("🦂 إظهار البرنامج (Show Scorpion IDM)", self)
        act_show.triggered.connect(self.bring_to_front)
        act_add = QAction("➕ إضافة رابط جديد (Add URL)", self)
        act_add.triggered.connect(lambda: self.open_add_dialog("", False))
        act_br = QAction("🧩 سيطب المتصفحات (Browser Setup)", self)
        act_br.triggered.connect(self.open_browser_setup_dialog)
        act_quit = QAction("❌ إغلاق البرنامج (Exit)", self)
        act_quit.triggered.connect(self.quit_app)
        tray_menu.addAction(act_show)
        tray_menu.addAction(act_add)
        tray_menu.addAction(act_br)
        tray_menu.addSeparator()
        tray_menu.addAction(act_quit)
        self.tray_icon.setContextMenu(tray_menu)
        self.tray_icon.activated.connect(
            lambda reason: self.bring_to_front()
            if reason in (QSystemTrayIcon.ActivationReason.Trigger, QSystemTrayIcon.ActivationReason.DoubleClick)
            else None
        )
        self.tray_icon.show()

    def bring_to_front(self):
        self.setWindowFlags(self.windowFlags() | Qt.WindowType.WindowStaysOnTopHint)
        self.showNormal()
        self.raise_()
        self.activateWindow()
        self.setWindowFlags(self.windowFlags() & ~Qt.WindowType.WindowStaysOnTopHint)
        self.show()

    def setup_ui(self):
        central = QWidget()
        self.setCentralWidget(central)
        root_layout = QVBoxLayout(central)
        root_layout.setContentsMargins(0, 0, 0, 0)
        root_layout.setSpacing(0)

        # 1. Top Native Toolbar
        toolbar = QFrame()
        toolbar.setObjectName("ToolbarFrame")
        tb_layout = QHBoxLayout(toolbar)
        tb_layout.setContentsMargins(14, 10, 14, 10)

        self.btn_add = QPushButton()
        self.btn_add.setObjectName("PrimaryBtn")
        self.btn_add.clicked.connect(lambda: self.open_add_dialog("", False))
        tb_layout.addWidget(self.btn_add)

        self.btn_video = QPushButton()
        self.btn_video.setObjectName("SuccessBtn")
        self.btn_video.clicked.connect(lambda: self.open_add_dialog("", True))
        tb_layout.addWidget(self.btn_video)

        self.btn_browser_setup = QPushButton()
        self.btn_browser_setup.setObjectName("PrimaryBtn")
        self.btn_browser_setup.clicked.connect(self.open_browser_setup_dialog)
        tb_layout.addWidget(self.btn_browser_setup)

        self.btn_resume = QPushButton()
        self.btn_resume.clicked.connect(self.resume_selected)
        tb_layout.addWidget(self.btn_resume)

        self.btn_pause = QPushButton()
        self.btn_pause.setObjectName("WarnBtn")
        self.btn_pause.clicked.connect(self.pause_selected)
        tb_layout.addWidget(self.btn_pause)

        self.btn_stop_all = QPushButton()
        self.btn_stop_all.setObjectName("DangerBtn")
        self.btn_stop_all.clicked.connect(self.engine.pause_all)
        tb_layout.addWidget(self.btn_stop_all)

        self.btn_delete = QPushButton()
        self.btn_delete.clicked.connect(self.delete_selected)
        tb_layout.addWidget(self.btn_delete)

        self.btn_clear_done = QPushButton()
        self.btn_clear_done.clicked.connect(self.engine.delete_completed)
        tb_layout.addWidget(self.btn_clear_done)

        tb_layout.addStretch()

        # Theme & Language Switchers
        self.btn_theme = QPushButton()
        self.btn_theme.clicked.connect(self.toggle_theme)
        tb_layout.addWidget(self.btn_theme)

        self.btn_lang = QPushButton()
        self.btn_lang.clicked.connect(self.toggle_lang)
        tb_layout.addWidget(self.btn_lang)

        root_layout.addWidget(toolbar)

        # 2. Main Splitter (Categories Tree + Downloads Table)
        splitter = QSplitter(Qt.Orientation.Horizontal)
        splitter.setContentsMargins(12, 12, 12, 12)

        self.tree = QTreeWidget()
        self.tree.setHeaderHidden(True)
        self.tree.setFixedWidth(235)
        self.tree.itemClicked.connect(self.on_tree_clicked)
        splitter.addWidget(self.tree)

        self.table = QTableWidget(0, 7)
        self.table.setAlternatingRowColors(True)
        self.table.setSelectionBehavior(QTableWidget.SelectionBehavior.SelectRows)
        self.table.setEditTriggers(QTableWidget.EditTrigger.NoEditTriggers)
        self.table.verticalHeader().setVisible(False)
        self.table.horizontalHeader().setSectionResizeMode(0, QHeaderView.ResizeMode.Stretch)
        self.table.cellDoubleClicked.connect(self.on_row_double_clicked)
        self.table.setContextMenuPolicy(Qt.ContextMenuPolicy.CustomContextMenu)
        self.table.customContextMenuRequested.connect(self.on_table_context_menu)
        splitter.addWidget(self.table)

        root_layout.addWidget(splitter, 1)

        # 3. Bottom Status Bar
        self.lbl_status_bar = QLabel()
        self.lbl_status_bar.setContentsMargins(14, 6, 14, 6)
        root_layout.addWidget(self.lbl_status_bar)

    def apply_theme_and_lang(self):
        is_ar = self.lang == "ar"
        self.setLayoutDirection(Qt.LayoutDirection.RightToLeft if is_ar else Qt.LayoutDirection.LeftToRight)
        self.app.setProperty("scorpionTheme", self.theme)
        self.app.setStyleSheet(LIGHT_QSS if self.theme == "light" else DARK_QSS)

        self.setWindowTitle(
            "🦂 Scorpion Download Manager (IDM النسخة الأصلية لسطح المكتب)"
            if is_ar
            else "🦂 Scorpion Download Manager (Native Desktop IDM)"
        )

        self.btn_add.setText("➕ إضافة رابط" if is_ar else "➕ Add URL")
        self.btn_video.setText("🎬 سحب فيديو (YouTube/Social)" if is_ar else "🎬 Grab Video")
        self.btn_browser_setup.setText("🧩 سيطب المتصفحات" if is_ar else "🧩 Browser Setup")
        self.btn_resume.setText("▶ استئناف" if is_ar else "▶ Resume")
        self.btn_pause.setText("⏸ إيقاف مؤقت" if is_ar else "⏸ Pause")
        self.btn_stop_all.setText("⏹ إيقاف الكل" if is_ar else "⏹ Stop All")
        self.btn_delete.setText("🗑 حذف" if is_ar else "🗑 Delete")
        self.btn_clear_done.setText("🧹 حذف المكتمل" if is_ar else "🧹 Clear Completed")

        self.btn_theme.setText(
            ("🌙 الوضع الليلي (Dark)" if self.theme == "light" else "☀️ الوضع الفاتح (Light)")
            if is_ar
            else ("🌙 Dark Mode" if self.theme == "light" else "☀️ Light Mode")
        )
        self.btn_lang.setText("🇺🇸 English" if is_ar else "🇪🇬 العربية")

        # Populate Category Tree
        self.tree.clear()
        root_all = QTreeWidgetItem(self.tree, ["📂 كل التحميلات (All)" if is_ar else "📂 All Downloads"])
        root_all.setData(0, Qt.ItemDataRole.UserRole, ("all", "ALL"))
        for cat_id, ar_lbl, en_lbl in [
            ("Video", "🎬 الفيديوهات", "🎬 Video"),
            ("Programs", "💿 البرامج", "💿 Programs"),
            ("Compressed", "📦 مضغوطة", "📦 Compressed"),
            ("Music", "🎵 الصوتيات", "🎵 Music"),
            ("Documents", "📄 المستندات", "📄 Documents"),
        ]:
            child = QTreeWidgetItem(root_all, [ar_lbl if is_ar else en_lbl])
            child.setData(0, Qt.ItemDataRole.UserRole, ("all", cat_id))
        root_all.setExpanded(True)

        unfinished = QTreeWidgetItem(self.tree, ["⏳ غير مكتمل (Unfinished)" if is_ar else "⏳ Unfinished"])
        unfinished.setData(0, Qt.ItemDataRole.UserRole, ("unfinished", "ALL"))

        finished = QTreeWidgetItem(self.tree, ["✅ مكتمل (Finished)" if is_ar else "✅ Completed"])
        finished.setData(0, Qt.ItemDataRole.UserRole, ("completed", "ALL"))

        self.table.setHorizontalHeaderLabels(
            ["اسم الملف", "الحجم", "الحالة والنسبة", "السرعة", "الوقت المتبقي", "الخطوط", "الاستكمال"]
            if is_ar
            else ["File Name", "Size", "Status & %", "Transfer Rate", "Time Left", "Segments", "Resume"]
        )

    def toggle_theme(self):
        self.theme = "dark" if self.theme == "light" else "light"
        self.engine.settings["theme"] = self.theme
        self.engine.save_state()
        self.apply_theme_and_lang()

    def toggle_lang(self):
        self.lang = "en" if self.lang == "ar" else "ar"
        self.engine.settings["lang"] = self.lang
        self.engine.save_state()
        self.apply_theme_and_lang()

    def on_table_context_menu(self, pos):
        row = self.table.rowAt(pos.y())
        if row < 0:
            return
        self.table.selectRow(row)
        dl_id = self.get_selected_id()
        item = self.engine.downloads.get(dl_id) if dl_id else None
        if not item:
            return

        is_ar = self.lang == "ar"
        menu = QMenu(self)

        if item["status"] == "completed" and os.path.exists(item["filePath"]):
            act_open = menu.addAction("▶ تشغيل الملف (Open File)" if is_ar else "▶ Open File")
            act_open.triggered.connect(lambda: os.startfile(item["filePath"]))

        act_folder = menu.addAction("📁 فتح المجلد (Open Folder)" if is_ar else "📁 Open Folder")
        act_folder.triggered.connect(lambda: self._open_item_folder(item))

        act_prog = menu.addAction("📊 نافذة تفاصيل التحميل (Progress Window)" if is_ar else "📊 Show Progress Window")
        act_prog.triggered.connect(lambda: self.open_progress_window(dl_id))

        if item["status"] != "completed":
            if item["status"] == "downloading":
                act_pause = menu.addAction("⏸ إيقاف مؤقت (Pause)" if is_ar else "⏸ Pause")
                act_pause.triggered.connect(lambda: self.engine.pause_download(dl_id))
            else:
                act_res = menu.addAction("▶ استئناف التحميل (Resume)" if is_ar else "▶ Resume")
                act_res.triggered.connect(lambda: (self.engine.start_download(dl_id), self.open_progress_window(dl_id)))

        menu.addSeparator()
        act_copy = menu.addAction("🔗 نسخ رابط التحميل (Copy URL)" if is_ar else "🔗 Copy Download URL")
        act_copy.triggered.connect(lambda: self._copy_url_safely(item["url"]))

        act_del = menu.addAction("🗑 حذف من القائمة (Delete)" if is_ar else "🗑 Delete")
        act_del.triggered.connect(self.delete_selected)

        menu.exec(self.table.viewport().mapToGlobal(pos))

    def _open_item_folder(self, item: dict):
        target = item["filePath"] if os.path.exists(item["filePath"]) else item["tempFilePath"]
        if os.path.exists(target):
            subprocess.Popen(["explorer", "/select,", os.path.normpath(target)])
        elif os.path.exists(item["saveDir"]):
            os.startfile(item["saveDir"])

    def _copy_url_safely(self, url: str):
        self.last_clip = url
        self.clipboard.setText(url)

    def on_tree_clicked(self, item: QTreeWidgetItem):
        data = item.data(0, Qt.ItemDataRole.UserRole)
        if data:
            self.filter_state, self.filter_cat = data
            self.refresh_all()

    def open_browser_setup_dialog(self):
        dlg = BrowserSetupDialog(self.engine, self.lang, self)
        dlg.exec()

    def on_browser_captured(self, payload: dict):
        url = (payload.get("url") or "").strip()
        if not url:
            return
        # Like IDM: only the download window pops up, the main window stays where it is

        is_video = payload.get("type") == "video"
        quality = payload.get("quality") or "best"
        title = (payload.get("title") or "").strip()
        filename = (payload.get("filename") or "").strip()

        if is_video and not filename and title:
            ext = ".mp3" if quality == "audio" else ".mp4"
            filename = sanitize_filename(title) + ext

        if self.engine.settings.get("autoStartFromBrowser", True):
            opts = {
                "url": url,
                "filename": filename,
                "referer": (payload.get("referer") or payload.get("pageUrl") or "").strip(),
                "category": "Video" if is_video else "",
                "totalSize": int(payload.get("totalSize") or 0),
                "connections": 16,
                "startImmediately": True,
                "isVideo": is_video and quality != "direct",
                "videoQuality": quality if quality in ("best", "720p", "480p", "audio") else "best",
            }
            item = self.engine.add_download(opts)
            self.open_progress_window(item["id"])
        else:
            self.open_add_dialog(url, is_video)

    def open_add_dialog(self, initial_url: str = "", is_video: bool = False):
        dlg = AddDownloadDialog(self.engine, initial_url, is_video, self.lang, self)
        if dlg.exec() == QDialog.DialogCode.Accepted and dlg.result_opts:
            item = self.engine.add_download(dlg.result_opts)
            if dlg.result_opts.get("startImmediately"):
                self.open_progress_window(item["id"])

    def open_progress_window(self, dl_id: str):
        w = self.open_progress_dialogs.get(dl_id)
        if w is None:
            w = IDMProgressDialog(self.engine, dl_id, self.lang, self)
            self.open_progress_dialogs[dl_id] = w
        w.refresh_ui()
        w.bring_to_front()

    def on_row_double_clicked(self, row: int, _col: int):
        id_item = self.table.item(row, 0)
        if id_item:
            dl_id = id_item.data(Qt.ItemDataRole.UserRole)
            if dl_id:
                self.open_progress_window(dl_id)

    def get_selected_id(self):
        row = self.table.currentRow()
        if row < 0:
            return None
        it = self.table.item(row, 0)
        return it.data(Qt.ItemDataRole.UserRole) if it else None

    def resume_selected(self):
        dl_id = self.get_selected_id()
        if dl_id:
            self.engine.start_download(dl_id)
            self.open_progress_window(dl_id)

    def pause_selected(self):
        dl_id = self.get_selected_id()
        if dl_id:
            self.engine.pause_download(dl_id)

    def delete_selected(self):
        dl_id = self.get_selected_id()
        if dl_id:
            self.engine.delete_download(dl_id)
            self.refresh_all()

    def on_clipboard_changed(self):
        text = self.clipboard.text().strip()
        if not text or text == self.last_clip:
            return
        self.last_clip = text
        exts = (".zip", ".rar", ".7z", ".exe", ".msi", ".iso", ".mp4", ".mkv", ".mp3", ".pdf", ".apk")
        if text.startswith(("http://", "https://")) and text.split("?")[0].lower().endswith(exts):
            self.open_add_dialog(text, False)

    def on_download_completed(self, dl_id: str):
        item = self.engine.downloads.get(dl_id)
        if not item:
            return
        dlg = self.open_progress_dialogs.get(dl_id)
        if dlg is not None and dlg.isVisible():
            # The progress window itself switches to the "complete" state
            return
        msg = QMessageBox(self if self.isVisible() else None)
        msg.setWindowFlags(msg.windowFlags() | Qt.WindowType.WindowStaysOnTopHint)
        msg.setWindowTitle("اكتمل التحميل - Scorpion IDM" if self.lang == "ar" else "Download Complete - Scorpion IDM")
        msg.setText(
            f"✅ اكتمل تحميل الملف بنجاح:\n{item['filename']}\n\nالمسار:\n{item['filePath']}"
            if self.lang == "ar"
            else f"✅ File downloaded successfully:\n{item['filename']}\n\nSaved to:\n{item['filePath']}"
        )
        btn_open = msg.addButton("تشغيل الملف" if self.lang == "ar" else "Open File", QMessageBox.ButtonRole.AcceptRole)
        btn_folder = msg.addButton("فتح المجلد" if self.lang == "ar" else "Open Folder", QMessageBox.ButtonRole.ActionRole)
        msg.addButton("إغلاق" if self.lang == "ar" else "Close", QMessageBox.ButtonRole.RejectRole)
        msg.exec()

        if msg.clickedButton() == btn_open and os.path.exists(item["filePath"]):
            os.startfile(item["filePath"])
        elif msg.clickedButton() == btn_folder and os.path.exists(item["filePath"]):
            subprocess.Popen(["explorer", "/select,", os.path.normpath(item["filePath"])])

    def closeEvent(self, event):
        # Like IDM: closing the main window keeps Scorpion running in the tray to catch browser downloads
        if getattr(self, "tray_icon", None) is not None and not getattr(self, "_really_quit", False):
            event.ignore()
            self.hide()
            if not getattr(self, "_tray_hint_shown", False):
                self._tray_hint_shown = True
                self.tray_icon.showMessage(
                    "Scorpion IDM",
                    "البرنامج شغال في الخلفية بجوار الساعة ويستقبل التحميلات من المتصفح"
                    if self.lang == "ar"
                    else "Scorpion keeps running in the tray to catch browser downloads",
                    QSystemTrayIcon.MessageIcon.Information,
                    3000,
                )
            return
        super().closeEvent(event)
        self.app.quit()

    def quit_app(self):
        self._really_quit = True
        self.engine.pause_all()
        self.app.quit()

    def refresh_all(self):
        items = sorted(self.engine.downloads.values(), key=lambda x: x.get("createdAt", 0), reverse=True)
        filtered = []
        total_spd = 0
        for it in items:
            if it["status"] == "downloading":
                total_spd += it.get("speed", 0)
            if self.filter_state == "unfinished" and it["status"] == "completed":
                continue
            if self.filter_state == "completed" and it["status"] != "completed":
                continue
            if self.filter_cat != "ALL" and it["category"] != self.filter_cat:
                continue
            filtered.append(it)

        sel_id = self.get_selected_id()
        self.table.setRowCount(len(filtered))
        for r, it in enumerate(filtered):
            c0 = QTableWidgetItem(it["filename"])
            c0.setData(Qt.ItemDataRole.UserRole, it["id"])
            self.table.setItem(r, 0, c0)
            self.table.setItem(r, 1, QTableWidgetItem(format_bytes(it["totalSize"] or it["downloadedBytes"])))
            self.table.setItem(r, 2, QTableWidgetItem(f"{it['status'].upper()} ({it.get('progress', 0):.1f}%)"))
            self.table.setItem(r, 3, QTableWidgetItem(format_speed(it["speed"]) if it["status"] == "downloading" else "—"))
            self.table.setItem(r, 4, QTableWidgetItem(format_eta(it["timeLeft"]) if it["status"] == "downloading" else "—"))
            self.table.setItem(r, 5, QTableWidgetItem(f"{len(it.get('segments', []))}x"))
            self.table.setItem(r, 6, QTableWidgetItem("Yes" if it.get("supportsRange") else "Stream"))
            if it["id"] == sel_id:
                self.table.selectRow(r)

        is_ar = self.lang == "ar"
        br_txt_ar = "🟢 جسر المتصفح: متصل ونشط" if self.engine.rpc_alive else "🟠 جسر المتصفح: قيد التشغيل"
        br_txt_en = "🟢 Browser Bridge: ONLINE" if self.engine.rpc_alive else "🟠 Browser Bridge: Starting"
        self.lbl_status_bar.setText(
            f"⚡ السرعة الكلية: {format_speed(total_spd)}   |   📂 إجمالي التحميلات: {len(items)}   |   {br_txt_ar}   |   📋 مراقبة الحافظة: مفعلة"
            if is_ar
            else f"⚡ Total Speed: {format_speed(total_spd)}   |   📂 Total Files: {len(items)}   |   {br_txt_en}   |   📋 Clipboard Grabber: ACTIVE"
        )


if __name__ == "__main__":
    # Single-instance guard: if already running, bring existing window to front and exit
    try:
        r = requests.get("http://127.0.0.1:19615/ping", timeout=0.6)
        if r.status_code == 200:
            requests.get("http://127.0.0.1:19615/focus", timeout=0.6)
            sys.exit(0)
    except Exception:
        pass

    app = QApplication(sys.argv)
    app.setQuitOnLastWindowClosed(False)
    win = ScorpionMainWindow(app)
    win.show()
    sys.exit(app.exec())
